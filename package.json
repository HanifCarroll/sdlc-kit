{
  "name": "sdlc-kit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanifCarroll/sdlc-kit.git"
  },
  "bugs": {
    "url": "https://github.com/HanifCarroll/sdlc-kit/issues"
  },
  "homepage": "https://github.com/HanifCarroll/sdlc-kit#readme",
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "ci": "bun run check && bun test && bun run sdlc --help",
    "test": "bun test",
    "lint": "bun run check",
    "sdlc": "bun run packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
